# Process environment only; .env files are not automatically loaded.
# Optional read-only access to the three original repositories:
GITHUB_TOKEN=
# Local HTTP transport requires a random secret, minimum 32 characters:
CARTIVO_MCP_TOKEN=
PORT=3100
# Enable only for trusted checkouts in an isolated runner without production secrets.
CARTIVO_ENABLE_LOCAL_CHECKS=false
CARTIVO_APPLICATION_PATH=
CARTIVO_FRONTEND_PATH=
